# Copy this file to server/.env and fill in real values. Never commit server/.env.

# Short timers + demo seed data
DEMO_MODE=true
# false = no made-up demo workers, only real phones
DEMO_WORKERS=true

# Texts. Leave CHERT_API_KEY empty to use the FakeSender (logs only).
CHERT_API_KEY=
CHERT_BASE_URL=
SUPERVISOR_PHONE=+10000000000

# Site
SITE_NAME=Arlington Site
SITE_CODE=ARL-0412

# Rescue trigger
COLLAPSE_PHONES=3
COLLAPSE_WINDOW_SEC=5

# A phone with no ping for this many seconds is shown as "phone lost"
PHONE_LOST_SEC=600

# Database file and the folder for scan files
BB_DB_PATH=blackbox.db
BB_SCANS_DIR=scans

# Feature flags (true / false)
FEATURE_SCAN_COMPARE=true
FEATURE_MESH=true
